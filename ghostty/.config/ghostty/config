# Font
font-family = Maple Mono NF
font-size = 17
adjust-cell-height = 8%

# Cursor
cursor-style = block
# cursor-blink = false

# Scroll
# scrollback-lines = 10000

# Themes
theme = Catppuccin Frappe
minimum-contrast = 4.5

# Background
background-opacity = 0.95
background-blur-radius = 16

# Window
window-padding-x = 10
window-padding-y = 8

# macOS
macos-titlebar-style = transparent
macos-option-as-alt = true

# ssh
# Auto-inject ghostty terminfo + TERM env into remote sessions.
# Fixes backspace, arrows, colors on hosts without xterm-ghostty terminfo.
# Requires shell integration (enabled by default).
shell-integration-features = ssh-env,ssh-terminfo

# fzf
frg() {
  local file
  file=$(rg --line-number --no-heading --color=always "" \
    | fzf --ansi --delimiter : \
    --preview 'bat --style=numbers --color=always {1} --line-range {2}:+20')
  [[ -n "$file" ]] && nvim "$(echo "$file" | cut -d: -f1)"
}

alias ff='fd --type f | fzf --preview "bat --style=numbers --color=always {}"'

fbr() {
  local branch
  branch=$(git branch --all | sed "s/.* //" | sed "s#remotes/[^/]*/##" | sort -u | fzf)
  [[ -n "$branch" ]] && git checkout "$branch"
}

fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
  [[ -n "$pid" ]] && kill -9 $pid
}

# zellij
zj() {
  [ -n "$ZELLIJ" ] && return
  local dir
  dir=$({
    fd -H --prune -t d -t f -d 12 -E node_modules -E vendor -E target -E .venv -E venv '^\.git$' ~/Projects/{work,labs,tools,archive} ~/Personal | sed 's|/\.git/\{0,1\}$||'
    fd -t d -d 2 -E node_modules -E venv -E dist -E src . ~/Projects/{tools,labs} | sed 's|/$||'
    fd -t d -d 1 . ~/Personal | sed 's|/$||'
  } 2>/dev/null | sort -u | tv) || return
  (cd "$dir" && zellij attach -c "$(basename "$dir" | tr . _)")
}

zl() {
  local session

  session=$(zellij list-sessions -n 2>/dev/null | tv | awk '{print $1}')

  if [[ -n "$session" ]]; then
    echo "Attaching to: $session..."
    zellij attach "$session"
  fi
}

